{
  "manifest_version": 3,
  "name": "Bookmark Folder Export",
  "version": "1.1.2",
  "description": "Export a bookmark folder (including subfolders) as Markdown, HTML, TXT or ZIP.",
  "homepage_url": "https://github.com/betakontext/bookmark-folder-export",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": ["bookmarks", "downloads", "contextMenus"],
  "browser_specific_settings": {
    "gecko": {
      "id": "bookmark-folder-export@betakontext.de",
      "data_collection_permissions": { "required": ["none"] },
      "strict_min_version": "140.0"
    }
  },
  "action": {
    "default_title": "Export bookmark folder",
    "default_icon": { "48": "icons/icon-48.png" }
  },
  "background": { "scripts": ["background.js"] }
}
